configuration {
  lines: 6;
  location: 0;
  width: 420;
  padding: 10;
  show-icons: true;
}
window {
  background-color: @base;
  border-radius: @radius;
  border: 2px;
  border-color: @border;
  text-color: @text;
}
mainbox { background-color: transparent; padding: 8px; }
listview { spacing: 4px; padding: 0; }
element {
  padding: 11px 14px;
  border-radius: 10px;
  background-color: transparent;
  text-color: @text;
}
element selected {
  background-color: @accent;
  text-color: @on-accent;
}
element-icon { size: 24px; }
inputbar { background-color: @base-alt; border-radius: 10px; padding: 9px 14px; text-color: @text; children: ["prompt","entry"]; }
prompt { text-color: @text-alt; }
message { text-color: @text-alt; }
