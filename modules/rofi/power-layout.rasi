* { font: "JetBrainsMonoNerdFont 14"; }
configuration {
  lines: 5;
  location: 0;
  width: 240;
  padding: 10;
}
window {
  background-color: @base;
  border-radius: @radius;
  border: 2px;
  border-color: @border;
  text-color: @text;
}
mainbox { background-color: transparent; padding: 8px; }
element {
  padding: 12px 16px;
  border-radius: 10px;
  background-color: transparent;
  text-color: @text;
}
element selected {
  background-color: @error-soft;
  text-color: @error;
}
listview { padding: 4px 0 0 0; spacing: 4px; }
